    {
      "id": "s10",
      "type": "single_fact",
      "question": "正规方程是怎么求解线性回归参数的",
      "refused": false,
      "sentinel_refused": false,
      "partial_gap": false,
      "expect_refusal": false,
      "refusal_correct": true,
      "citation_count": 0,
