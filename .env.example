# ===== LLM（可选其一，默认 DeepSeek）=====
# 想用哪家就改 LLM_PROVIDER，代码一行不用动（注册表见 src/llm_factory.py）
#   deepseek | ollama | zhipu | siliconflow | qwen | moonshot | openai
LLM_PROVIDER=deepseek
# 留空 = 用该 provider 的第一个模型
LLM_MODEL=

# --- DeepSeek（默认）---
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- 本地 Ollama：真免费，但需要装 Ollama 并 pull 一个模型 ---
#   安装：https://ollama.com/download
#   拉模型：ollama pull qwen2.5:7b
#   然后设 LLM_PROVIDER=ollama（不需要 API key）
# OLLAMA_API_KEY=

# --- 智谱（有免费档 glm-4-flash）---
# ZHIPU_API_KEY=xxx

# --- SiliconFlow 硅基流动（有免费档 Qwen2.5-7B）---
# SILICONFLOW_API_KEY=xxx

# --- 阿里百炼 / 通义 ---
# DASHSCOPE_API_KEY=xxx

# --- 月之暗面 Kimi ---
# MOONSHOT_API_KEY=xxx

# --- OpenAI ---
# OPENAI_API_KEY=xxx

# ===== 自定义端点（自建 vLLM / one-api 网关 / 公司内网）=====
# 只在 provider == LLM_PROVIDER 时生效
# LLM_API_BASE=http://127.0.0.1:8080/v1
# LLM_API_KEY=anything

LOG_LEVEL=INFO
